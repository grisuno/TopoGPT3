{"uid":"topogpt3/jlens.py::jacobian_for_prompt","name":"jacobian_for_prompt","qualname":"jacobian_for_prompt","kind":"function","file":"topogpt3/jlens.py","line":187,"end_line":280,"language":"py","signature":"def jacobian_for_prompt(model: LensModel, prompt: str, source_layers: Sequence[int], *, target_layer: int | None = None, dim_batch: int = 8, max_seq_len: int = 128, skip_first: int = SKIP_FIRST_N_POSITIONS) -> tuple[dict[int, torch.Tensor], int, int]","params":[{"name":"model","annotation":"LensModel","default":"","kind":"positional"},{"name":"prompt","annotation":"str","default":"","kind":"positional"},{"name":"source_layers","annotation":"Sequence[int]","default":"","kind":"positional"},{"name":"target_layer","annotation":"int | None","default":"None","kind":"keyword_only"},{"name":"dim_batch","annotation":"int","default":"8","kind":"keyword_only"},{"name":"max_seq_len","annotation":"int","default":"128","kind":"keyword_only"},{"name":"skip_first","annotation":"int","default":"SKIP_FIRST_N_POSITIONS","kind":"keyword_only"}],"returns":"tuple[dict[int, torch.Tensor], int, int]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Compute the per-layer Jacobian estimator ``J_l`` for one prompt.","description":"Runs one forward pass on the prompt replicated ``dim_batch`` times along\nthe batch axis, retains the graph, then runs ``ceil(d_model / dim_batch)``\nbackward passes against it. Each backward computes ``dim_batch`` rows of\n``J_l`` at once: batch element ``b`` carries a one-hot cotangent at output\ndimension ``dim_start + b``, set at every valid target position.","params":[{"name":"model","type":"","description":"The model to compute Jacobians for.","default":""},{"name":"prompt","type":"","description":"Input text.","default":""},{"name":"source_layers","type":"","description":"Layer indices ``l`` to compute ``J_l`` at.","default":""},{"name":"target_layer","type":"","description":"Layer to take gradients with respect to. Defaults to the final layer; negative indices count from the end.","default":"the"},{"name":"dim_batch","type":"","description":"Output dimensions computed per backward pass.","default":""},{"name":"max_seq_len","type":"","description":"Truncate the prompt to this many tokens.","default":""},{"name":"skip_first","type":"","description":"Leading positions to exclude.","default":""}],"returns":{"name":"","type":"","description":"``(jacobians, seq_len, n_valid_positions)``. ``jacobians`` maps each\nsource layer to a ``[d_model, d_model]`` fp32 CPU tensor.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"topogpt3/jlens.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["topogpt3/jlens.py::ActivationRecorder.__init__","topogpt3/jlens.py::valid_position_mask","topogpt3/lens_model.py::LensModel.encode","topogpt3/lens_model.py::LensModel.forward"],"called_by":["topogpt3/jlens.py::fit"]}
