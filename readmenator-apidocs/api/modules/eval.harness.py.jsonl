{"uid":"eval/harness.py","name":"harness.py","qualname":"eval/harness.py","kind":"module","file":"eval/harness.py","line":1,"end_line":394,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Harness for evaluating TopoGPT3 on HumanEval (164 problems).","description":"Faithful to the official HumanEval protocol: for each problem we feed the\nmodel the function signature and docstring, let it produce a completion,\nextract the candidate function (everything from `def` up to a sentinel),\nand run the hidden test against it. We do NOT use `entry_point` from the\ndataset because the prompt we feed the model already contains it.\n\nTwo sampler modes are supported:\n  - \"standard\" -> topogpt3.InferencePipeline\n  - \"hrm\"      -> topogpt3.HRMInferencePipeline\n\nResults are written to JSONL so multiple sampler configurations can share\na single HumanEval cache and be compared later.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["eval/harness.py::HF_HE_REPO","eval/harness.py::load_humaneval","eval/harness.py::build_prompt","eval/harness.py::extract_candidate","eval/harness.py::run_one_test","eval/harness.py::run_one_test_sandboxed","eval/harness.py::make_sampler","eval/harness.py::completion_for_problem","eval/harness.py::ModelLoader","eval/harness.py::evaluate_problem","eval/harness.py::main"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
